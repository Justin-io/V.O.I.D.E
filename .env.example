# ==============================================================================
# V.O.I.D.E. Environment Configuration Template
# Copy this file to .env and configure your local or cloud LLM settings.
# ==============================================================================

# --- LLM Provider & Reasoning Gateway ---
# Option 1: OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
VOIDE_LLM_PROVIDER=openai

# Option 2: Local & Free with Ollama (No API Key Required)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_MODEL=llama3.1
# VOIDE_LLM_PROVIDER=ollama

# Option 3: OpenRouter Multi-Model Gateway
# OPENAI_API_KEY=sk-or-v1-...
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=anthropic/claude-3.5-sonnet
# VOIDE_LLM_PROVIDER=openrouter

# Option 4: DeepSeek API
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat
# VOIDE_LLM_PROVIDER=deepseek

# --- Desktop Shell & IPC Daemon Settings ---
VOIDE_IPC_PORT=8766
VOIDE_HEADLESS_BROWSER=true
