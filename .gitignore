# ==============================================================================
# V.O.I.D.E. Hardened Zero-Leak .gitignore
# ==============================================================================

# --- Secrets, API Keys & Credentials ---
.env
.env.*
!.env.example
*.key
*.pem
*.pfx
*.pkcs12
*.id_rsa
*.id_ed25519
id_rsa
id_ed25519
credentials.json
client_secret*.json
service_account*.json
token.json
*.p12

# --- Python Bytecode & Environments ---
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
dist/
build/
*.egg-info/
.eggs/
venv/
.venv/
env/
ENV/

# --- V.O.I.D.E. Runtime, State Databases & Locks ---
.voide/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
agent/storage/*.db
SingletonLock
SingletonSocket
chromium_profile/
--help/

# --- Dynamic Run Artifacts & Generated Reports ---
reports/
visuals/
data/
datasets/
*.log

# --- Flutter & Dart Build Output ---
.dart_tool/
.packages
apps/voide_desktop/.dart_tool/
apps/voide_desktop/.packages
apps/voide_desktop/build/
apps/voide_desktop/linux/flutter/ephemeral/

# --- IDE & Editor Configurations ---
*.iml
.idea/
.vscode/

# --- OS System Artifacts ---
.DS_Store
Thumbs.db
